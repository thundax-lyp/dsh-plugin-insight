                {
                    "id": "contribution",
                    "topic": "technical_innovation",
                    "basis": "interpretation",
                    "text": "相较手写CSS，把字体发现、阅读对比与预设调节做成双入口，并用present区分尚未配置和明确恢复默认，避免迁移抹掉旧偏好。它是可读性配置集成，不能由WCAG预览徽标推出壁纸背景上所有文字均达标。",
                    "evidence_ids": [
                        "2026-10-21-06-github-1388463793-root-source"
                    ],
                    "dependencies": [
                        {
