                {
                    "id": "contribution",
                    "topic": "technical_innovation",
                    "basis": "interpretation",
                    "text": "相对仅看聊天文件列表或git diff，增量是把工具改动、逐块决定、行引用与重启后待审状态接到同一界面，降低审阅与Agent沟通的切换。差分算法和FS由上游能力支撑，主要贡献在状态与交互接线。",
                    "evidence_ids": [
                        "2026-10-21-03-github-1335980444-root-source"
                    ],
                    "dependencies": [
                        {
                            "plugin_id": "github:1335980444:root",
