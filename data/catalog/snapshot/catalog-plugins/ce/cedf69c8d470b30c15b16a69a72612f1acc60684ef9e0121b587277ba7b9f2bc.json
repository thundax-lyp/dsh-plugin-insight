          "fingerprint": "52e1d551a8ede5d7d3cbeb4157fca8655be2f401"
        }
      ],
      "reviewed_at": "2026-10-21T03:18:37.445Z",
      "status": "current"
    },
    {
      "id": "critical_question",
      "topic": "limitations",
      "basis": "interpretation",
      "text": "manifest标web是否意味着浏览器版可用？实际依赖dshDesktop.browser bridge，普通Web只有说明；主进程租约、partition和允许导航规则未包含在本仓库，不能从注释认定隔离。固定Chrome/131 UA和注入Fullscreen shim还会受站点改版影响；同一guest处理弹窗导航，离开抖音后的行为需宿主约束核对。",
      "evidence_ids": [
