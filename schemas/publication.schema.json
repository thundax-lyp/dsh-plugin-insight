{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session",
    "scope",
    "report",
    "recommendation_page",
    "catalog_page",
    "recommendations",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "report": {
      "type": "string",
      "minLength": 1
    },
    "recommendation_page": {
      "type": "string",
      "minLength": 1
    },
    "catalog_page": {
      "type": "string",
      "minLength": 1
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin_id",
          "kind",
          "summary"
        ],
        "properties": {
          "plugin_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "install",
              "trial",
              "observe"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "scope",
          "changes",
          "report"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "string",
            "minLength": 1
          },
          "report": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
