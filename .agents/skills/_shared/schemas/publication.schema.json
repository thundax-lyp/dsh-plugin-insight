{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session",
    "scope",
    "report",
    "recommendation_page",
    "catalog_page",
    "recommendations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "report": {
      "type": "string",
      "minLength": 1
    },
    "recommendation_page": {
      "type": "string",
      "minLength": 1
    },
    "catalog_page": {
      "type": "string",
      "minLength": 1
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin_id",
          "kind",
          "summary"
        ],
        "properties": {
          "plugin_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "install",
              "trial",
              "observe"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "scope",
          "changes",
          "report"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "string",
            "minLength": 1
          },
          "report": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalog": {
      "type": "string",
      "minLength": 1
    },
    "summaries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "source_url",
          "revision"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\r\\n]+$"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "items"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Skill": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "Agent/Preset": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "模型工具": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "用户命令": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "Host 路由": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "界面": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "事件监听": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "后台": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              }
            }
          }
        }
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "text"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
