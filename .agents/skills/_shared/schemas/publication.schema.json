{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "catalog",
    "catalog_page"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "manifests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "catalog_page": {
      "type": "string",
      "minLength": 1
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin_id",
          "kind",
          "summary"
        ],
        "properties": {
          "plugin_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "install",
              "trial",
              "observe"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "仅兼容历史输入；当前推荐从catalog插件的recommendation派生，生成器忽略本名单。"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalog": {
      "type": "string",
      "minLength": 1
    },
    "summaries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "source_url",
          "revision"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\r\\n]+$"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "items"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Skill": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "Agent/Preset": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "模型工具": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "用户命令": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "Host 路由": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "界面": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "事件监听": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "后台": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              }
            }
          }
        }
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "text"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "path",
          "revision",
          "fingerprints",
          "source_urls",
          "status",
          "analysis_sha256",
          "checked_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "fingerprints": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "status": {
            "const": "complete"
          },
          "analysis_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "required": [
        "manifest"
      ],
      "properties": {
        "manifest": {}
      }
    },
    {
      "required": [
        "records",
        "checked_at"
      ],
      "properties": {
        "records": {},
        "checked_at": {}
      }
    }
  ]
}
