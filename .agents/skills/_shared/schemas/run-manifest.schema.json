{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round",
    "session_id",
    "checked_at",
    "previous_session_sha256",
    "sources",
    "summary",
    "items",
    "tooling",
    "reproducibility",
    "commands",
    "local_artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "round": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{2,}$" },
    "session_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "checked_at": { "type": "string", "format": "date-time" },
    "previous_session_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "revision", "complete"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "revision": { "type": ["string", "null"] },
          "complete": { "type": "boolean" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listed", "selected", "complete", "blocked", "pending", "deferred", "changes"],
      "properties": {
        "listed": { "type": "integer", "minimum": 0 },
        "selected": { "type": "integer", "minimum": 0 },
        "complete": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "deferred": { "type": "integer", "minimum": 0 },
        "changes": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "path", "revision", "fingerprints", "source_urls", "changes", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^github:[0-9]+:[a-zA-Z0-9_-]+$" },
          "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "path": { "type": "string" },
          "revision": { "type": ["string", "null"] },
          "fingerprints": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uri" }
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["added", "moved", "content_changed", "sources_changed", "unchanged", "removed_from_source", "unknown"]
            }
          },
          "status": { "enum": ["pending", "blocked", "complete"] },
          "analysis_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reason": { "type": "string", "minLength": 1 },
          "checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "observations_sha256", "report_sha256"],
            "properties": {
              "run_id": { "type": "string", "minLength": 1 },
              "observations_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "complete" } } },
            "then": { "required": ["checkpoint"], "properties": { "checkpoint": {} } }
          },
          {
            "if": { "properties": { "status": { "const": "blocked" } } },
            "then": { "required": ["reason"], "properties": { "reason": {} } }
          }
        ]
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_version", "package_lock_sha256", "workflow_sha256"],
      "properties": {
        "node_version": { "type": "string", "minLength": 1 },
        "package_lock_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "workflow_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "limitations"],
      "properties": {
        "level": { "const": "workflow" },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "local_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "session_sha256"],
      "properties": {
        "root": { "type": "string", "pattern": "^data/runs/\\d{4}-\\d{2}-\\d{2}-\\d{2,}$" },
        "session_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
