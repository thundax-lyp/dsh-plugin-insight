{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_digest",
    "head",
    "parts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "head": {
      "$ref": "#/$defs/ref"
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "refs"
            ],
            "properties": {
              "kind": {
                "const": "array"
              },
              "refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "refs"
            ],
            "properties": {
              "kind": {
                "const": "map"
              },
              "refs": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "refs",
              "order"
            ],
            "properties": {
              "kind": {
                "const": "keyed-array"
              },
              "refs": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/ref"
                }
              },
              "order": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^snapshot/[a-z-]+/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
