{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "checked_at", "plugins", "errors"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date-time"},
    "plugins": {"type": "array", "items": {"$ref": "catalog.schema.json#/$defs/plugin"}},
    "errors": {"$ref": "catalog.schema.json#/$defs/run/properties/errors"}
  }
}
