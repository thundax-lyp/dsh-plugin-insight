{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "base_digest",
        "input_digest",
        "semantic_digest",
        "input",
        "queue",
        "session",
        "records"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "base_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "semantic_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "records": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appended_items",
        "groups"
      ],
      "properties": {
        "appended_items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "changes",
              "indices"
            ],
            "properties": {
              "changes": {
                "type": "array",
                "items": {
                  "enum": [
                    "added",
                    "moved",
                    "unknown",
                    "content_changed",
                    "sources_changed",
                    "unchanged",
                    "removed_from_source"
                  ]
                }
              },
              "indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "states"
      ],
      "properties": {
        "header": {
          "type": "object"
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "blocked",
                  "complete"
                ]
              },
              "reason": {
                "type": "string"
              },
              "checkpoint": {
                "type": "object"
              },
              "block": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "work"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "work": {
          "const": "WORK.json"
        }
      }
    }
  }
}
