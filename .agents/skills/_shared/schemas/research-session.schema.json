{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "checked_at",
    "previous_digest",
    "sources",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "revision",
          "complete"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "complete": {
            "type": "boolean"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "path",
          "revision",
          "fingerprints",
          "source_urls",
          "changes",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^github:[0-9]+:[a-zA-Z0-9_-]+$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "path": {
            "type": "string"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "fingerprints": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "added",
                "moved",
                "content_changed",
                "sources_changed",
                "unchanged",
                "removed_from_source",
                "unknown"
              ]
            }
          },
          "status": {
            "enum": [
              "pending",
              "blocked",
              "complete"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observations",
              "observations_digest",
              "report",
              "report_digest",
              "run_id"
            ],
            "properties": {
              "observations": {
                "type": "string",
                "minLength": 1
              },
              "observations_digest": {
                "type": "string",
                "minLength": 1
              },
              "report": {
                "type": "string",
                "minLength": 1
              },
              "report_digest": {
                "type": "string",
                "minLength": 1
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "complete"
                }
              }
            },
            "then": {
              "required": [
                "checkpoint"
              ],
              "properties": {
                "checkpoint": {}
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "blocked"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {}
              }
            }
          }
        ]
      }
    },
    "research_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "selected_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "base_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "researched_ids",
        "review_required_ids"
      ],
      "properties": {
        "mode": {
          "const": "incremental"
        },
        "researched_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^github:[0-9]+:[a-zA-Z0-9_-]+$"
          }
        },
        "review_required_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^github:[0-9]+:[a-zA-Z0-9_-]+$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "dependentRequired": {
    "research_limit": [
      "selected_ids"
    ],
    "selection": [
      "selected_ids",
      "base_digest"
    ]
  },
  "allOf": [
    {
      "if": {
        "required": [
          "selected_ids"
        ],
        "not": {
          "required": [
            "selection"
          ],
          "properties": {
            "selection": {}
          }
        },
        "properties": {
          "selected_ids": {}
        }
      },
      "then": {
        "required": [
          "research_limit"
        ],
        "properties": {
          "research_limit": {}
        }
      }
    }
  ]
}
