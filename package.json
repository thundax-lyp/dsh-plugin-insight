{
  "name": "dsh-plugin-insight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "validate": "node scripts/plugin-data.mjs validate",
    "validate:data": "node scripts/validate-data.mjs && npm run render:research -- --check",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate:data && npm test",
    "research": "node scripts/research-session.mjs",
    "render:research": "node scripts/render-research.mjs --input data/publications/current.json",
    "capture:meta": "node scripts/capture-plugin-meta.mjs",
    "inventory:plugin": "node scripts/plugin-inventory.mjs",
    "loc": "sloc",
    "refresh:meta": "node scripts/refresh-meta.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1",
    "sloc": "0.3.2",
    "typescript": "5.9.3"
  },
  "license": "CC0-1.0"
}
