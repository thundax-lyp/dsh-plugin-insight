{
    "name": "dsh-plugin-insight",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.19.0"
    },
    "scripts": {
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "validate": "node .agents/skills/_shared/scripts/plugin-data.mjs validate",
        "validate:data": "node .agents/skills/dsh-plugin-init/scripts/validate-data.mjs && npm run render:research -- --check",
        "check": "npm run format:check && npm run validate:data",
        "research:input": "node .agents/skills/dsh-plugin-init/scripts/build-research-input.mjs",
        "research": "node .agents/skills/dsh-plugin-init/scripts/research-session.mjs",
        "prepare:plugin": "node .agents/skills/dsh-plugin-insight/scripts/prepare-plugin-materials.mjs",
        "publication": "node .agents/skills/dsh-plugin-init/scripts/publication-data.mjs",
        "render:research": "node .agents/skills/dsh-plugin-init/scripts/render-research.mjs --input data/catalog/index.jsonl",
        "export:package-manifest": "node .agents/skills/dsh-plugin-init/scripts/export-package-manifest.mjs",
        "capture:meta": "node .agents/skills/dsh-plugin-insight/scripts/capture-plugin-meta.mjs",
        "inventory:plugin": "node .agents/skills/dsh-plugin-insight/scripts/plugin-inventory.mjs",
        "loc": "sloc",
        "refresh:meta": "node .agents/skills/dsh-plugin-init/scripts/refresh-meta.mjs",
        "migrate:data": "node .agents/skills/dsh-plugin-init/scripts/migrate-data.mjs",
        "maintain:runs": "node .agents/skills/dsh-plugin-init/scripts/maintain-runs.mjs",
        "codex-review": "node .agents/skills/codex-comment-fix/scripts/codex-review.mjs",
        "snapshot": "node .agents/skills/dsh-plugin-init/scripts/snapshot-data.mjs",
        "prepare:selected": "node .agents/skills/dsh-plugin-init/scripts/prepare-selected.mjs",
        "assemble:insight": "node .agents/skills/dsh-plugin-insight/scripts/assemble-insight.mjs"
    },
    "devDependencies": {
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "js-yaml": "5.3.0",
        "jsonc-parser": "3.3.1",
        "prettier": "3.9.10",
        "sloc": "0.3.2",
        "typescript": "5.9.3"
    },
    "license": "CC0-1.0"
}
